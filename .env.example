# API настройки (обязательно для доступа к API)
API_KEYS=test-api-key-123,another-key-456

# Redis (обязательно для API)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-password-if-needed

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# XMLRiver (для Wordstat и Yandex Search в pipeline)
# XMLRIVER_USER_ID=your-user-id
# XMLRIVER_API_KEY=your-api-key

# LLM провайдеры (минимум один для генерации метатегов)
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# XAI_API_KEY=your-xai-key
# DEEPSEEK_API_KEY=your-deepseek-key
# GOOGLE_API_KEY=your-google-key

# Логирование
LOG_LEVEL=INFO

# Виртуальный дисплей для Chrome на сервере (Linux без GUI)
# DISPLAY=:99
