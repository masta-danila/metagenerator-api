[Unit]
Description=Metagenerator API (FastAPI + Celery)
After=network.target redis.service

[Service]
Type=forking
User=callchecker
Group=callchecker
WorkingDirectory=/home/callchecker/metagenerator-api
Environment="PATH=/home/callchecker/metagenerator-api/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Запуск API и Celery через supervisor или tmux
ExecStart=/bin/bash /home/callchecker/metagenerator-api/start_all.sh

# Остановка
ExecStop=/bin/bash /home/callchecker/metagenerator-api/stop_all.sh

# Автоматический перезапуск при падении
Restart=on-failure
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metagenerator-api

# Тайм-ауты
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
