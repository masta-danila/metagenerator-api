[Unit]
Description=SEO Tools Parser with Xvfb
After=network.target

[Service]
Type=simple
User=callchecker
Group=callchecker
WorkingDirectory=/home/callchecker/seotools
Environment="PATH=/home/callchecker/seotools/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Запуск через bash скрипт с Xvfb
ExecStart=/bin/bash /home/callchecker/seotools/start_with_xvfb.sh

# Автоматический перезапуск при падении
Restart=on-failure
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=seotools

# Тайм-аут для запуска и остановки
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
